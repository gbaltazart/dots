    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Fn Lock: Toggle standard F-keys / Media keys with Fn + Esc (Auto-enables in Moonlight)",
                        "manipulators": [
                            {
                                "conditions": [
                                    { "name": "fn_lock", "type": "variable_if", "value": 0 }
                                ],
                                "description": "Toggle fn_lock variable ON (1) when Fn + Esc is pressed and it was OFF (0)",
                                "from": {
                                    "key_code": "escape",
                                    "modifiers": { "mandatory": ["fn"] }
                                },
                                "to": [
                                    { "set_variable": { "name": "fn_lock", "value": 1 } },
                                    {
                                        "set_notification_message": {
                                            "duration_milliseconds": 1500,
                                            "id": "fn_lock_status",
                                            "text": "Fn Lock: ON (Standard F-Keys)"
                                        }
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    { "name": "fn_lock", "type": "variable_if", "value": 1 }
                                ],
                                "description": "Toggle fn_lock variable OFF (0) when Fn + Esc is pressed and it was ON (1)",
                                "from": {
                                    "key_code": "escape",
                                    "modifiers": { "mandatory": ["fn"] }
                                },
                                "to": [
                                    { "set_variable": { "name": "fn_lock", "value": 0 } },
                                    {
                                        "set_notification_message": {
                                            "duration_milliseconds": 1500,
                                            "id": "fn_lock_status",
                                            "text": "Fn Lock: OFF (Media Keys)"
                                        }
                                    }
                                ],
                                "type": "basic"
                            },
